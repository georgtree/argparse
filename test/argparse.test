-rest*} {-help} {cmd ?-rest ?value ...??} synopsisText

testTemplate synopsisTest-4 {required catchall switch still permits zero values} {-help {} -helpret -synopsiscmd cmd} {
{-rest* -required}} {-help} {cmd -rest ?value ...?} synopsisText

testTemplate synopsisTest-5 {required positional catchall needs at least one value}\
        {-help {} -helpret -synopsiscmd cmd} {
{files -catchall -required}} {-help} {cmd files ?files ...?} synopsisText

testTemplate synopsisTest-6 {pfirst stably partitions parameters around switches}\
        {-help {} -helpret -synopsiscmd cmd -pfirst} {
{before -optional}
first
-flag
second
{rest -catchall}} {-help} {cmd first second ?-flag? ?before? ?rest ...?} synopsisText

testTemplate synopsisTest-7 {mixed uses representative switches-first order}\
        {-help {} -helpret -synopsiscmd cmd -mixed} {
{before -optional}
first
-flag
second} {-help} {cmd ?-flag? ?before? first second} synopsisText

testTemplate synopsisTest-8 {aliases long syntax equalarg and defaults do not change canonical spelling}\
        {-help {} -helpret -synopsiscmd cmd -long -equalarg -boolean} {
{-o|output= -default default.txt}
-quiet} {--help} {cmd ?-output value? ?-quiet?} synopsisText

testTemplate synopsisTest-9 {hidden required elements are omitted from synopsis too}\
        {-help {} -helpret -synopsiscmd cmd} {
{-secret= -required -hsuppress}
{hidden -hsuppress}
visible} {-help} {cmd visible} synopsisText


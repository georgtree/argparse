# Invocation contexts
test synopsis-inference-contexts {top level, namespaced proc, wrapper, ensemble and method} -setup {
    interp create synopsisInterp
    synopsisInterp eval [list set auto_path $auto_path]
    synopsisInterp eval {package require argparse}
} -body {
    synopsisInterp eval {
        proc prefix {text} {
            string range $text 0 [expr {[string first "\n\n" $text] - 1}]
        }
        namespace eval tools {
            proc impl {args} {
                argparse -help {} -helpret -synopsis {input} {} {-help}
            }
            namespace ensemble create -command ::tools -map {convert ::tools::impl}
        }
        proc wrapper {} {
            tools::impl
        }
        oo::class create Converter {
            method convert {} {
                argparse -help {} -helpret -synopsis {input} {} {-help}
            }
        }
        Converter create obj
        set results [list [prefix [argparse -help {} -helpret -helplevel 1 -synopsis {input} {} {-help}]]\
                             [prefix [tools::impl]] [prefix [wrapper]] [prefix [tools convert]]\
                             [prefix [tools conv]] [prefix [obj convert]]]
        set results
    }
} -cleanup {
    interp delete synopsisInterp
} -result {{command input} {tools::impl input} {tools::impl input} {::tools::impl input} {::tools::impl input}\
                   {::obj convert input}}

test synopsis-inference-wrapper {immediate parser wrapper is not skipped} -setup {
    proc synopsisWrapper {} {
        argparse -help {} -helpret -synopsis {input} {} {-help}
    }
    proc synopsisPublic {} {
        synopsisWrapper
    }
} -body {
    synopsisText [synopsisPublic]
} -cleanup {
    rename synopsisWrapper {}
    rename synopsisPublic {}
} -result {synopsisWrapper input}

test synopsis-constraints-description {all requirements and simultaneous allow rule are visible} -body {
    set text [argparse -help {} -helpret -helplevel 1 -synopsiscmd cmd {
        {-a -require {b c} -allow {b c}}
        -b
        -c
    } {-help}]
    list [string match {*Requires b and c.*} $text] [string match {*Allows b or c.*} $text]
} -result {1 1}

test synopsis-wrap {long synopsis wraps with four-space continuation and preserves case} -body {
    set text [synopsisText [argparse -help {} -helpret -helplevel 1 -synopsiscmd lowerCase\
                                    -synopsis [join [lrepeat 20 {?-option value?}]] {} {-help}]]
    set lines [split $text \n]
    set valid [expr {[llength $lines] > 1 && [string match {lowerCase *} [lindex $lines 0]]}]
    foreach line [lrange $lines 1 end] {
        if {![string match {    *} $line] || [string length $line] > 80} {
            set valid 0
        }
    }
    set valid
} -result 1

test synopsis-missing-values {both new switches diagnose missing values} -body {
    set results {}
    foreach option {-synopsis -synopsiscmd} {
        catch {argparse $option} message
        lappend results $message
    }
    set results
} -result {{-synopsis requires an argument} {-synopsiscmd requires an argument}}

test synopsis-cache-callers {cached definitions do not cache caller names or override text} -setup {
    proc synopsisOne {} {
        argparse -help {} -helpret {-flag} {-help}
    }
    proc synopsisTwo {} {
        argparse -help {} -helpret {-flag} {-help}
    }
} -body {
    set results [list [synopsisText [synopsisOne]] [synopsisText [synopsisTwo]]]
    foreach name {first second} text {{arg ?arg?} {input ...}} {
        lappend results [synopsisText [argparse -help {} -helpret -helplevel 1 -synopsiscmd $name -synopsis $text\
                                               {-flag} {-help}]]
    }
    set results
} -cleanup {
    rename synopsisOne {}
    rename synopsisTwo {}
} -result {{synopsisOne ?-flag?} {synopsisTwo ?-flag?} {first arg ?arg?} {second input ...}}

test synopsis-empty-parts {both empty parts suppress the paragraph without an extra blank line} -body {
    string match {Description.*} [argparse -help Description -helpret -helplevel 1 -synopsis {} -synopsiscmd {} {}\
                                          {-help}]
} -result 1

test synopsis-no-caller-variables {inference does not create variables in the caller frame} -setup {
    proc synopsisLocals {} {
        set before [lsort [info locals]]
        set text [argparse -help {} -helpret -helplevel 1 {} {-help}]
        unset text before
        info locals
    }
} -body {
    synopsisLocals
} -cleanup {
    rename synopsisLocals {}
} -result {}

# Compare complete returned AND printed messages, including inference, wrapping,
# constraints and both manual fields, against an independently loaded backend.
test synopsis-backend-parity {native and reference help agree across tricky definitions} -setup {
    set source [file join $currentDir .. argparse.tcl]
    foreach backend {synopsisInstalled synopsisReference} {
        interp create $backend
        $backend eval [list set auto_path $auto_path]
        if {$backend eq {synopsisInstalled}} {
            $backend eval {package require argparse}
        } else {
            $backend eval [list source $source]
        }
        $backend eval {
            rename puts savedPuts
            proc puts {text} {lappend ::output $text}
            proc invoke {options definition argv} {
                set ::output {}
                set code [catch {argparse -help {} -helplevel 1 {*}$options $definition $argv} value opts]
                list $code $value [dict get $opts -level] $::output
            }
            namespace eval public {
                proc implementation {args} {argparse -help {} -helpret {-flag} {-help}}
                namespace ensemble create -command ::public -map {run ::public::implementation}
            }
            oo::class create Probe {
                method run {} {argparse -help {} -helpret {-flag} {-help}}
                method override {} {
                    argparse -help {} -helpret -synopsiscmd {public run} {-flag} {-help}
                }
            }
            Probe create object
        }
    }
} -body {
    set same 1
    set cases {
        {{} {{-a -require {b c} -allow {b c}} -b -c} {-help}}
        {{-pfirst} {{extra -optional} first -flag second rest*} {-help}}
        {{-mixed -pass rest} {-flag input files*} {-help}}
        {{-long -equalarg} {-v|verbose -o|output=} {--help}}
        {{} {{-b= -imply -c} {-c= -required} {-version -standalone}} {-help}}
        {{} {{-a -key mode -require c -reciprocal} {-b -key mode} -c} {-help}}
        {{} {{secret -hsuppress} {-value? -required} files*!} {-help}}
        {{-synopsiscmd {public run} -synopsis {$x [error BAD] ?file?}} {} {-help}}
        {{-synopsiscmd {} -synopsis {}} {} {-help}}
    }
    lappend cases [list [list -synopsiscmd lowerCase -synopsis [string repeat {?-flag value? } 20]] {} {-help}]
    foreach case $cases {
        lassign $case options definition argv
        foreach mode {{} -helpret} {
            set script [list invoke [concat $options $mode] $definition $argv]
            set actual [synopsisInstalled eval $script]
            if {([lindex $actual 0] != 0) || ($actual ne [synopsisReference eval $script])} {
                set same 0
            }
        }
    }
    foreach script {{public run} {public r} {object run} {object override}} {
        if {[synopsisInstalled eval $script] ne [synopsisReference eval $script]} {
            set same 0
        }
    }
    set same
} -cleanup {
    interp delete synopsisInstalled synopsisReference
} -result 1

rename synopsisText {}

### Constructor synopsis uses the instantiated class, not its anonymous instance.
foreach backend {constructorInstalled constructorReference} {
    interp create $backend
    $backend eval [list set auto_path $auto_path]
    if {$backend eq {constructorInstalled}} {
        $backend eval {package require argparse}
    } else {
        $backend eval [list source [file join $currentDir .. argparse.tcl]]
    }
    $backend eval {
        rename puts savedPuts
        proc puts {text} {set ::constructorHelp $text}
        namespace eval constructors {
            oo::class create Base {
                constructor {args} {
                    argparse -help {} {
                        {-value= -required}
                        -quiet
                    }
                    return -code error {constructor continued after help}
                }
                method constructor {} {
                    argparse -help {} {
                        -flag
                    } {-help}
                }
            }
            oo::class create Child {
                superclass Base
            }
            oo::class create Delegating {
                superclass Base
                constructor {args} {
                    next {*}$args
                }
            }
            oo::class create Override {
                constructor {args} {
                    argparse -help {} -synopsiscmd {factory build} {
                        {-value= -required}
                        -quiet
                    }
                }
            }
            oo::class create Manual {
                constructor {args} {
                    argparse -help {} -synopsis {custom ?extra?} {
                        input
                    }
                }
            }
        }
        proc creationSynopsis {invocation} {
            set ::constructorHelp {}
            set object [uplevel #0 $invocation]
            $object destroy
            string range $::constructorHelp 0 [expr {[string first "\n\n" $::constructorHelp] - 1}]
        }
    }
}

foreach {name invocation expected} {
    new {constructors::Base new -help} {::constructors::Base new -value value ?-quiet?}
    create {constructors::Base create named -help} {::constructors::Base create objectName -value value ?-quiet?}
    inherited-new {constructors::Child new -help} {::constructors::Child new -value value ?-quiet?}
    inherited-create {constructors::Child create named -help}\
            {::constructors::Child create objectName -value value ?-quiet?}
    next-fallback {constructors::Delegating create named -help} {::constructors::Delegating new -value value ?-quiet?}
    override {constructors::Override create named -help} {factory build -value value ?-quiet?}
    manual-arguments {constructors::Manual create named -help} {::constructors::Manual create objectName custom ?extra?}
    private-name {constructors::Base create {private instance name} -help}\
            {::constructors::Base create objectName -value value ?-quiet?}
} {
    test synopsis-constructor-$name {constructor inference and overrides agree in both implementations} -body {
        set results {}
        foreach backend {constructorInstalled constructorReference} {
            lappend results [$backend eval [list creationSynopsis $invocation]]
        }
        set results
    } -result [list $expected $expected]
}

test synopsis-constructor-named-method {ordinary method named constructor keeps object-method syntax} -body {
    set results {}
    foreach backend {constructorInstalled constructorReference} {
        lappend results [$backend eval {
            constructors::Base create instance -help
            instance constructor
            instance destroy
            string range $::constructorHelp 0 [expr {[string first "\n\n" $::constructorHelp] - 1}]
        }]
    }
    set results
} -result {{::instance constructor ?-flag?} {::instance constructor ?-flag?}}

interp delete constructorInstalled constructorReference

### Method detection uses public frame metadata and never probes an unrelated self.
foreach backend {frameInstalled frameReference} {
    interp create $backend
    $backend eval [list set auto_path $auto_path]
    if {$backend eq {frameInstalled}} {
        $backend eval {package require argparse}
    } else {
        $backend eval [list source [file join $currentDir .. argparse.tcl]]
    }
    $backend eval {
        set ::selfCalls 0
        proc self {args} {
            incr ::selfCalls
            error {unrelated self was called}
        }
        proc extractSynopsis {text} {
            string range $text 0 [expr {[string first "\n\n" $text] - 1}]
        }
        proc plain {} {
            argparse -help {} -helpret -synopsis input {} {-help}
        }
        oo::class create FrameProbe {
            constructor {} {
                set ::constructorText [eval {argparse -help {} -helpret -helplevel 1 -synopsis input {} {-help}}]
            }
            method direct {} {
                argparse -help {} -helpret -synopsis input {} {-help}
            }
            method evaluated {} {
                eval {argparse -help {} -helpret -synopsis input {} {-help}}
            }
            method delegated {} {
                plain
            }
            method global {} {
                uplevel #0 {argparse -help {} -helpret -helplevel 1 -synopsis input {} {-help}}
            }
            method procedure {} {
                uplevel 1 {argparse -help {} -helpret -helplevel 1 -synopsis input {} {-help}}
            }
        }
        FrameProbe create frameObject
        proc caller {} {
            frameObject procedure
        }
    }
}
foreach {name script expected} {
    top-level {argparse -help {} -helpret -helplevel 1 -synopsis input {} {-help}} {command input}
    procedure {plain} {plain input}
    method {frameObject direct} {::frameObject direct input}
    eval-method {frameObject evaluated} {::frameObject evaluated input}
    eval-constructor {set ::constructorText} {::FrameProbe create objectName input}
    method-wrapper {frameObject delegated} {plain input}
    uplevel-global {frameObject global} {command input}
    uplevel-procedure {caller} {caller input}
} {
    test synopsis-public-frame-$name {public method detection respects execution context in both backends} -body {
        set results {}
        foreach backend {frameInstalled frameReference} {
            set text [$backend eval $script]
            lappend results [$backend eval [list extractSynopsis $text]] [$backend eval {set ::selfCalls}]
        }
        set results
    } -result [list $expected 0 $expected 0]
}
interp delete frameInstalled frameReference

### Issue #23: -exclusive is the no-argument form of -allow {}.
testTemplate exclusiveTest-1 {exclusive switch alone} {} {
{-version -exclusive}
-other} {-version} {version {}}

testTemplate exclusiveTest-2 {exclusive switch rejects another switch} {} {
{-version -exclusive}
-other} {-version -other} {version doesn't allow other}

testTemplate exclusiveTest-3 {exclusive switch rejects preceding switch} {} {
{-version -exclusive}
-other} {-other -version} {version doesn't allow other}

testTemplate exclusiveTest-4 {aliases and repeated occurrences refer to the same element} {} {
{-v|version -exclusive}} {-v -version} {version {}}

testTemplate exclusiveTest-5 {switch value does not count as another element} {} {
{-only= -exclusive}} {-only value} {only value}

testTemplate exclusiveTest-6 {optional positional parameter cannot accompany exclusive switch} {} {
{-only -exclusive}
{file -optional}} {-only file.txt} {only doesn't allow file}

testTemplate exclusiveTest-7 {exclusive does not waive required parameters} {-mixed} {
{-only -exclusive}
file} {-only} {missing required parameter: file}

testTemplate exclusiveTest-8 {exclusive does not waive required switches} {} {
{-only -exclusive}
{-out= -required}} {-only} {missing required switch: -out}

testTemplate exclusiveTest-9 {exclusive positional parameter alone} {} {
{first -exclusive}
{second -optional}} {one} {first one}

testTemplate exclusiveTest-10 {exclusive positional parameter rejects another parameter} {} {
{first -exclusive}
{second -optional}} {one two} {first doesn't allow second}

testTemplate exclusiveTest-11 {omitted defaults are not present elements} {} {
{-only -exclusive}
{-other= -default fallback}} {-only} {other fallback only {}}

testTemplate exclusiveTest-12 {standalone keeps its existing constraint-waiving behavior} {} {
{-only -exclusive}
{-other -standalone}} {-only -other} {other {} only {}}

testTemplate exclusiveTest-13 {explicit allow conflicts regardless of option order} {} {
{-only -exclusive -allow {}}} {} {-exclusive and -allow conflict}

testTemplate exclusiveTest-14 {explicit nonempty allow cannot override exclusive} {} {
{-only -allow other -exclusive}
-other} {} {-exclusive and -allow conflict}

testTemplate exclusiveTest-15 {ordinary allow-forbid conflict survives normalization} {} {
{-only -exclusive -forbid other}
-other} {} {-allow and -forbid conflict}

testTemplate exclusiveTest-16 {repeated flag is idempotent} {} {
{-only -exclusive -exclusive}} {-only} {only {}}

testTemplate exclusiveTest-17 {required-by relationship is still enforced} {} {
{-only -exclusive -require other}
-other} {-only} {-only requires -other}

testTemplate exclusiveTest-18 {satisfying require does not bypass exclusivity} {} {
{-only -exclusive -require other}
-other} {-only -other} {only doesn't allow other}

# Compare complete help and parse outcomes, including cached native definitions.
test exclusive-parity {abbreviation matches empty allow in both implementations} -setup {
    foreach backend {exclusiveInstalled exclusiveReference} {
        interp create $backend
        $backend eval [list set auto_path $auto_path]
        if {$backend eq {exclusiveInstalled}} {
            $backend eval {package require argparse}
        } else {
            $backend eval [list source [file join $currentDir .. argparse.tcl]]
        }
    }
} -body {
    set same 1
    foreach argv {{-help} {-only} {-only -other} {-other -only} {-other} {}} {
        set outcomes {}
        foreach backend {exclusiveInstalled exclusiveReference} {
            foreach flag {{-exclusive} {-allow {}}} {
                set definition [list [list -only {*}$flag] -other]
                set script [list argparse -inline -help {} -helpret -helplevel 1 -synopsiscmd cmd $definition $argv]
                set code [catch {$backend eval $script} result]
                lappend outcomes [list $code $result]
            }
        }
        foreach outcome [lrange $outcomes 1 end] {
            if {$outcome ne [lindex $outcomes 0]} {
                set same 0
            }
        }
    }
    set same
} -cleanup {
    interp delete exclusiveInstalled exclusiveReference
} -result 1

test exclusive-help {empty allow is described clearly, including a whitespace-only list} -body {
    set result {}
    foreach flag {{-exclusive} {-allow {}} {-allow {   }}} {
        set text [argparse -help {} -helpret -helplevel 1 -synopsiscmd cmd \
                [list [list -only {*}$flag]] {-help}]
        lappend result [string match {*Allows no other elements.*} $text]
    }
    set result
} -result {1 1 1}

cleanupTests

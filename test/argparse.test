### Check -upvar option
test upvarTest-1 {} -body {
    proc upvarProc {args} {
        argparse {
            {a -upvar}
            b
            c
        }
        set a "$b+$c"
    }
    upvarProc p 1 2
    return $p
} -result 1+2 -cleanup {
    rename upvarProc {}
    unset p
}

test upvarTest-2 {} -body {
    proc upvarProc {args} {
        argparse {
            {-a= -upvar}
            b
            c
        }
        set a "$b+$c"
    }
    upvarProc -a p 1 2
    return $p
} -result 1+2 -cleanup {
    rename upvarProc {}
    unset p
}

test upvarTest-3 {} -body {
    proc upvarProc {args} {
        argparse {
            {-a= -key j -upvar}
            {-b= -key j -upvar}
            c
        }
        set a $c
        set b $c
    }
    catch {upvarProc -a p -b p 1} errorStr
    return $errorStr
} -result {multiple upvars to the same variable: a b} -cleanup {
    rename upvarProc {}
    unset errorStr
}


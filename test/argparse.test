-flag
input} {-help} {cmd ?-flag? input ?arg ...?} synopsisText

testTemplate synopsisTest-11 {overlapping constraints do not invent alternatives} {-help {} -helpret -synopsiscmd cmd} {
{-a -forbid b}
{-b -forbid c}
-c} {-help} {cmd ?-a? ?-b? ?-c?} synopsisText

testTemplate synopsisTest-12 {contradictory required and allow rules are not solved}\
        {-help {} -helpret -synopsiscmd cmd} {
{-a= -required}
{-b -allow {}}} {-help} {cmd -a value ?-b?} synopsisText


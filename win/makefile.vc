#------------------------------------------------------------- -*- makefile -*-
#
# nmake Makefile for argparse
#
# Basic build, test and install
#   nmake /f makefile.vc INSTALLDIR=c:\path\to\tcl
#   nmake /f makefile.vc INSTALLDIR=c:\path\to\tcl test
#   nmake /f makefile.vc INSTALLDIR=c:\path\to\tcl install
#
# For other build options (debug, static etc.),
# See TIP 477 (https://core.tcl-lang.org/tips/doc/main/tip/477.md) for
# detailed documentation.
#
# See the file "license.terms" for information on usage and redistribution
# of this file, and for a DISCLAIMER OF ALL WARRANTIES.
#
#------------------------------------------------------------------------------

# The name of the package
PROJECT = argparse

# Define TESTDIR because it is named "test" and not the standard "tests"
TESTDIR  = $(ROOT)\test

# C11 is needed for inline functions and compound literals.
COMPILERFLAGS = $(COMPILERFLAGS) /std:c11
DISABLE_TARGET_test = 1
!include "rules-ext.vc"

# Define the object files and resource file that make up the extension.
# Note the resource file does not makes sense if doing a static library build
# hence it is under that condition. TMP_DIR is the output directory
# defined by rules for object files.
PRJ_OBJS = \
	$(TMP_DIR)\argparse.obj

PRJ_INCLUDES = -I$(TMP_DIR)

# Define any additional compiler flags that might be required for the project
# PRJ_DEFINES = -D_CRT_SECURE_NO_DEPRECATE

# Define the standard targets
!include "$(_RULESDIR)\targets.vc"

# We must define a pkgindex target that will create a pkgIndex.tcl
# file in the $(OUT_DIR) directory. We could normally just use the
# pkgindex-default-tea rules but not in this case as there is the
# non-standard HAVE_TCL_ONLY substitution.
pkgindex:
	@if exist $(ROOT)\pkgIndex.tcl.in nmakehlp -s << $(ROOT)\pkgIndex.tcl.in > $(OUT_DIR)\pkgIndex.tcl
@PACKAGE_VERSION@    $(DOTVERSION)
@PACKAGE_NAME@       $(PRJ_PACKAGE_TCLNAME)
@PACKAGE_TCLNAME@    $(PRJ_PACKAGE_TCLNAME)
@PKG_LIB_FILE@       $(PRJLIBNAME)
@PKG_LIB_FILE8@      $(PRJLIBNAME8)
@PKG_LIB_FILE9@      $(PRJLIBNAME9)
@HAVE_TCL_ONLY@      0
<<

# Uncomment following if there is documentation to be copied
# and layed out as per TEA.
# install: default-install-docs-n default-install-docs-html

# Use manifest file which defines commit id for build-info command
$(TMP_DIR)\manifest.uuid:
!IF EXIST($(ROOT)\manifest.uuid)
	@copy "$(ROOT)\manifest.uuid" "$(TMP_DIR)\manifest.uuid"
!ELSE
!IF EXIST($(ROOT)\.git)
	@echo puts -nonewline git- | "$(TCLSH)" >$(TMP_DIR)\manifest.uuid
	@git rev-parse HEAD >>$(TMP_DIR)\manifest.uuid || echo git-unknown >$(TMP_DIR)\manifest.uuid
!ELSE
	@echo unknown >$(TMP_DIR)\manifest.uuid
!ENDIF
!ENDIF

$(TMP_DIR)\myExtensionUuid.h: $(TMP_DIR)\manifest.uuid
	@echo #define MYEXTENSION_VERSION_UUID \> $(TMP_DIR)\myExtensionUuid.h
	@type $(TMP_DIR)\manifest.uuid >> $(TMP_DIR)\myExtensionUuid.h
	@echo:>>$(TMP_DIR)\myExtensionUuid.h


# Run the same suite in separate processes, attempting both even if C fails.
test: $(PROJECT)
	@call test-both.cmd "$(TCLSH)" "$(ROOT)" "$(PRJLIB)" "$(TESTFLAGS)"

# argparse.tcl lives in the repository root rather than the usual library/.
install: install-tcl-source
install-tcl-source: default-install
	@$(CPY) "$(ROOT)\argparse.tcl" "$(SCRIPT_INSTALL_DIR)"

# Explicit dependency rules
$(TMP_DIR)\argparse.obj : $(GENERICDIR)\argparse.h

# Full binary distribution, with the same contents as TEA's make dist.
# tar.exe is supplied by supported Windows versions (libarchive/bsdtar).
!ifndef DIST_ROOT
DIST_ROOT = $(OUT_DIR)\dist
!endif
DIST_PACKAGE = $(PROJECT)$(DOTVERSION)

DIST_DIR = $(DIST_ROOT)\$(DIST_PACKAGE)
DIST_LIB = $(DIST_DIR)\lib\$(DIST_PACKAGE)
DIST_DATA = $(DIST_DIR)\share\$(DIST_PACKAGE)
DIST_DOC = $(DIST_DATA)\doc
DIST_MAN = $(DIST_DIR)\share\man\mann

dist-stage: $(PROJECT)
	@if exist "$(DIST_DIR)" rmdir /s /q "$(DIST_DIR)"
	@cmd.exe /d /e:on /c mkdir "$(DIST_LIB)\test"
	@cmd.exe /d /e:on /c mkdir "$(DIST_DOC)"
	@cmd.exe /d /e:on /c mkdir "$(DIST_MAN)"
	@$(CPY) "$(ROOT)\README.md" "$(DIST_DATA)\"
	@$(CPY) "$(ROOT)\LICENSE" "$(DIST_DATA)\"
	@$(CPY) "$(PRJLIB)" "$(DIST_LIB)\"
	@for %f in ("$(ROOT)\*.tcl") do @if exist "%f" if /i not "%~nxf"=="pkgIndex.tcl" ($(CPY) "%f" "$(DIST_LIB)\" || exit /b 1)
	@$(CPY) "$(OUT_DIR)\pkgIndex.tcl" "$(DIST_LIB)\"
	@$(CPY) "$(TESTDIR)\all.tcl" "$(DIST_LIB)\test\"
	@for %f in ("$(TESTDIR)\*.test") do @if exist "%f" ($(CPY) "%f" "$(DIST_LIB)\test\" || exit /b 1)
	@for %f in ("$(ROOT)\docs\*.html" "$(ROOT)\docs\*.js" "$(ROOT)\docs\*.inv" "$(ROOT)\docs\.nojekyll") do @if exist "%f" ($(CPY) "%f" "$(DIST_DOC)\" || exit /b 1)
	@for %f in ("$(ROOT)\docs\*.n") do @if exist "%f" ($(CPY) "%f" "$(DIST_MAN)\" || exit /b 1)
	@for %d in (_static assets images _images) do @if exist "$(ROOT)\docs\%d\" (xcopy /E /I /Y "$(ROOT)\docs\%d" "$(DIST_DOC)\%d" >nul || exit /b 1)

dist: dist-stage
	"$(SystemRoot)\System32\tar.exe" -czf "$(DIST_ROOT)\$(DIST_PACKAGE).tar.gz" -C "$(DIST_DIR)" .

dist-zip: dist
	"$(SystemRoot)\System32\tar.exe" -a -cf "$(DIST_ROOT)\$(DIST_PACKAGE).zip" -C "$(DIST_DIR)" .
